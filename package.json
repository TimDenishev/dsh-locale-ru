{
  "name": "dsh-locale-ru",
  "version": "0.1.0",
  "description": "Русский язык интерфейса DeepSeek Harness: языковой пакет для Настройки → Общие → Язык",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml"],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "locale", "i18n", "russian"],
  "license": "MIT"
}
